# ВАЖНО: git НЕ поддерживает комментарии в КОНЦЕ строки с шаблоном —
# такой «# ...» становится частью шаблона и ломает игнор. Комментарии — только
# на отдельных строках (как здесь).

# ── Рантайм-данные и секреты (НИКОГДА не коммитим) ──
secure_data.enc
api_config.json
data.key
audit.log
login_throttle.json
# Логи фоновых процессов сервера/туннеля (server/server.log, server/tunnel.log) и пр.
*.log
backups/
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak
*.pid

# ── Конфигурация окружения ──
.env
.env.*
# шаблон .env.example коммитим (реальные секреты — нет)
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
# Исключение из строки выше. `web/build/` — НЕ артефакт сборки, а ЕЁ ИСХОДНИК:
# там лежит плагин Vite, который импортирует `vite.config.js`. Правило `build/`
# заведено для питоновских каталогов сборки и проглотило его молча — файл не был
# в git НИ РАЗУ, то есть на чистом клоне `npm run build` падал
# «Cannot find module». Держит `web/tests/buildFromCleanClone.test.mjs`.
!web/build/
dist/
*.egg-info/
.eggs/

# ── Виртуальные окружения ──
.venv/
venv/
env/
ENV/

# ── Сборка PyInstaller ──
*.spec
*.manifest

# ── IDE / редакторы ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OTA-бандлы приложения (артефакты релиза; apk-info.json коммитим, бандлы — нет) ──
server/ota_bundles/*.zip
server/ota_bundles/latest.json

# ── ОС ──
.DS_Store
Thumbs.db
desktop.ini

# ── СЕКРЕТЫ ПОДПИСИ ANDROID — НИКОГДА не коммитить ─────────────────────────────────
# release.keystore — ключ подписи приложения в RuStore. Его утечка = чужие сборки под
# нашим именем; его потеря = невозможность выпускать обновления. Хранить вне git (бэкап!).
release.keystore
*.keystore
*.jks
keystore.properties
web/android/keystore.properties

# ── Сборочные артефакты и сторонние бинарники (не место в репозитории) ─────────────
*.apk
*.aab
Sdk.zip
caddy.exe
nuitka_out/
nuitka-crash-report.xml
web/*.zip
# Dependency Walker для Nuitka-сборки под Windows (depends.exe и пр.) — тулчейн, а не код.
x86_64/

# ── Ключ шифрования боевой БД (SQLCipher) — НИКОГДА в репозиторий ───────────────────
# Временный файл на dev-машине. Его утечка = компрометация всей продовой базы (152-ФЗ).
GB_DB_KEY.txt

# ── Реальные журналы с ПДн студентов (152-ФЗ) — только локально ────────────────────
Журнал_*.xlsx

# ── Сайты Synapse (отдельный публичный репозиторий, не тащим сюда) ──
сайты/

# ── Дизайн-подбор логотипа (галереи + копии шрифтов). Одобренный знак уже в коде
# приложения; папку-подбор в репозиторий не тащим (как и сайты/).
логотипы/

# ── Собранные OTA-бандлы (артефакты сборки, в репозиторий не тащим)
web/ota-out/

# ── Состав поставки (SBOM) ──
# Генерируется `tools/make_sbom.sh` при каждом релизе и кладётся РЯДОМ С
# АРТЕФАКТОМ, а не в репозиторий: это снимок конкретной поставки, а не исходник.
sbom/

# Собранные артефакты релиза — версионированные архивы, не исходники.
dist-release/

# ── Кеши инструментов (места на диске много, в git не нужны) ──
.mypy_cache/
.playwright-mcp/

# ── Локальный контур Codex ───────────────────────────────────────────────────
# Настройки, память и роли Codex зависят от локальной сессии и не являются
# исходным кодом продукта. Корневой AGENTS.md тоже локален: он указывает Codex
# перечитывать синхронную копию проектных правил перед каждой задачей.
/.codex/
/AGENTS.md
